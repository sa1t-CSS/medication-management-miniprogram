.morning-page {
  min-height: 100vh;
  background: #eeeeef;
  padding-top: 36rpx;
}

.period-header {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff6df 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 159, 10, 0.28);
  box-shadow: var(--shadow);
}

.period-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff9f0a;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 26rpx rgba(255, 159, 10, 0.30);
}

.section-title {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--text-dark);
  line-height: 1.2;
}

.selected-date-sub {
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 26rpx;
  font-weight: 700;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-left: 8rpx solid #ff9f0a;
  box-shadow: var(--shadow);
}

.plan-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.placeholder-image {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff4df;
  color: #a05a00;
  font-size: 36rpx;
  font-weight: 900;
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-name {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text-dark);
  margin-bottom: 8rpx;
}

.plan-dose {
  font-size: 26rpx;
  color: var(--text-light);
  font-weight: 700;
}

.plan-time {
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: #fff4df;
  color: #8a4b00;
  font-size: 26rpx;
  font-weight: 900;
}

.empty-state {
  padding: 56rpx 24rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--text-dark);
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-light);
}

.add-medication-btn {
  margin-top: 36rpx;
  padding: 26rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #111827;
  color: #ffffff;
  border: 2rpx solid #000000;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 26rpx rgba(17, 24, 39, 0.28);
}
