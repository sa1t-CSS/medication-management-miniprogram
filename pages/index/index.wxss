.index-page {
  padding-top: 32rpx;
}

.school-brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef8f2 100%);
  border: 1rpx solid rgba(0, 135, 74, 0.16);
  box-shadow: var(--shadow);
}

.school-logo {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #ffffff;
  border: 2rpx solid rgba(0, 135, 74, 0.2);
}

.school-info {
  flex: 1;
  min-width: 0;
}

.school-name {
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #00874a;
}

.school-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--text-light);
}

/* 日历样式 */
.calendar-section {
  margin-bottom: 30rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.calendar-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-dark);
}

.calendar-nav {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.current-month {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text-dark);
  min-width: 180rpx;
  text-align: center;
}

.nav-btn {
  font-size: 34rpx;
  color: var(--primary-color);
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 122, 255, 0.16);
  box-shadow: 0 8rpx 20rpx rgba(60, 60, 67, 0.12);
}

.calendar-weekdays {
  display: flex;
  margin-bottom: 20rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-light);
  font-weight: 700;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.day {
  width: 14.28%;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 10rpx;
}

.day-number {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-dark);
  background-color: transparent;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
}

.day.today .day-number {
  font-weight: 800;
}

.day.selected .day-number {
  font-weight: 800;
}

.day.has-medication .day-number {
  background: #ff9f0a;
  color: #ffffff;
  font-weight: 800;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  box-shadow: 0 10rpx 22rpx rgba(255, 159, 10, 0.34);
}

.medication-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: conic-gradient(
    #d89b35 0% 33.33%,
    #30b0c7 33.33% 66.66%,
    #5856d6 66.66% 100%
  );
  z-index: 1;
  opacity: 0.95;
  box-shadow: 0 10rpx 22rpx rgba(60, 60, 67, 0.16);
}

.medication-count {
  position: absolute;
  top: -14rpx;
  right: -12rpx;
  background: linear-gradient(135deg, #ff453a, #d70015);
  color: white;
  border-radius: 999rpx;
  min-width: 44rpx;
  height: 38rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(215, 0, 21, 0.36);
  box-sizing: border-box;
}

.empty {
  visibility: hidden;
}

/* 三个时间段区块容器 */
.time-blocks-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin: 40rpx 0;
}

.time-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 34rpx rgba(60, 60, 67, 0.12);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.time-block:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.morning-block {
  background: linear-gradient(135deg, #fff8e6 0%, #ff9f0a 100%);
}

.noon-block {
  background: linear-gradient(135deg, #e8f8fb 0%, #30b0c7 100%);
}

.evening-block {
  background: linear-gradient(135deg, #5856d6 0%, #1c1c1e 100%);
  color: white;
}

.block-text {
  font-size: 36rpx;
  font-weight: bold;
}

.block-count {
  font-size: 28rpx;
  opacity: 0.9;
  background-color: rgba(255, 255, 255, 0.42);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.evening-block .block-count {
  background-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
}

.reminder-section {
  margin-top: 60rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: var(--text-dark);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clear-reminders {
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 10rpx 20rpx;
  background-color: var(--primary-soft);
  border: 1rpx solid rgba(37, 111, 123, 0.28);
  border-radius: 20rpx;
}

.reminder-item {
  display: flex;
  padding: 24rpx;
  background-color: var(--white);
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid var(--primary-color);
  border-top: 1rpx solid var(--border-color);
  border-right: 1rpx solid var(--border-color);
  border-bottom: 1rpx solid var(--border-color);
}

.reminder-time {
  width: 160rpx;
  color: var(--primary-color);
  font-weight: bold;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.reminder-content {
  flex: 1;
}

.reminder-period {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}

.reminder-medicine {
  font-size: 28rpx;
  color: var(--text-dark);
  font-weight: bold;
}

.no-reminder {
  text-align: center;
  color: var(--text-light);
  padding: 60rpx 0;
  font-size: 28rpx;
}

.emergency-float {
  position: fixed;
  right: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 880;
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 230rpx;
  padding: 12rpx 16rpx 12rpx 12rpx;
  background: rgba(217, 77, 77, 0.96);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(217, 77, 77, 0.26);
}

.emergency-label {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  font-weight: 800;
}

.emergency-phone {
  flex: 1;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
