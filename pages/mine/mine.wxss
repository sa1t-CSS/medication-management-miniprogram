.mine-page {
  background: var(--gray);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.mine-header {
  font-size: 52rpx;
  font-weight: 800;
  text-align: left;
  padding: 48rpx 20rpx 34rpx;
  color: var(--text-dark);
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 40rpx;
  color: var(--text-dark);
}

.plan-section {
  margin-bottom: 50rpx;
}

.plan-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  color: var(--primary-color);
  border-left: 8rpx solid var(--primary-color);
  padding-left: 20rpx;
}

.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid var(--primary-color);
  border-top: 1rpx solid var(--border-color);
  border-right: 1rpx solid var(--border-color);
  border-bottom: 1rpx solid var(--border-color);
}

.plan-info {
  flex: 1;
}

.med-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: var(--text-dark);
}

.med-details {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.4;
}

.plan-actions {
  display: flex;
  gap: 20rpx;
}

.plan-actions .icon {
  font-size: 36rpx;
  padding: 10rpx;
}

.edit-icon {
  color: var(--primary-color);
}

.delete-icon {
  color: var(--danger-color);
}

.add-btn {
  padding: 24rpx;
  text-align: center;
  border: 2rpx dashed rgba(0, 122, 255, 0.42);
  color: var(--text-dark);
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffffff, var(--primary-soft));
  font-weight: bold;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  background-color: white;
  width: 85%;
  border-radius: 30rpx;
  overflow: hidden;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  background: linear-gradient(135deg, var(--primary-color), var(--primary-deep));
  color: white;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: white;
}

.modal-body {
  padding: 30rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  color: var(--text-dark);
  font-weight: bold;
}

.form-input {
  border: 2rpx solid var(--border-color);
  border-radius: 18rpx;
  padding: 22rpx;
  font-size: 28rpx;
  background-color: #ffffff;
}

.date-picker, .time-picker {
  color: var(--text-light);
}

.duration-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.duration-btn {
  padding: 22rpx 25rpx;
  border: 3rpx solid rgba(0, 122, 255, 0.28);
  border-radius: 20rpx;
  background: #f4f4f6;
  color: var(--text-dark);
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  transition: all 0.3s ease;
  flex: 1;
  min-width: 120rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.75);
}

.duration-btn.active {
  background: #111827;
  color: #ffffff !important;
  border-color: #111827;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.28);
  transform: translateY(-2rpx);
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.btn {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: 0;
}

.btn-cancel {
  color: var(--text-light);
  border-right: 1rpx solid var(--border-color);
}

.btn-confirm {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-deep));
  color: #ffffff;
}

.modal-footer .btn {
  margin: 18rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--border-color);
}

.modal-footer .btn-cancel {
  background: #f4f4f6;
  color: var(--text-dark);
  border-color: rgba(60, 60, 67, 0.18);
}

.modal-footer .btn-confirm {
  background: #111827;
  color: #ffffff !important;
  border-color: #000000;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.30);
}

.emergency-card {
  border-left: 8rpx solid var(--danger-color);
  background: linear-gradient(135deg, #fff5f5 0%, #ffffff 100%);
}

.medication-manage-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(234, 243, 255, 0.58));
}

.bluetooth-card {
  border-left: 8rpx solid #30b0c7;
  background: linear-gradient(135deg, #e8f8fb 0%, #ffffff 100%);
}

.bluetooth-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  margin-bottom: 20rpx;
}

.bluetooth-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #8e8e93;
  box-shadow: 0 0 0 8rpx rgba(142, 142, 147, 0.14);
  flex-shrink: 0;
}

.bluetooth-dot.connected {
  background: #34c759;
  box-shadow: 0 0 0 8rpx rgba(52, 199, 89, 0.16);
}

.bluetooth-status-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-dark);
}

.bluetooth-connected {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(48, 176, 199, 0.26);
  margin-bottom: 20rpx;
}

.connected-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-dark);
  margin-bottom: 8rpx;
}

.connected-id {
  font-size: 22rpx;
  color: var(--text-light);
  word-break: break-all;
}

.bluetooth-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.bluetooth-btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 900;
  border: 2rpx solid transparent;
}

.bluetooth-btn.primary {
  background: #111827;
  color: #ffffff;
  border-color: #000000;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.26);
}

.bluetooth-btn.secondary {
  background: #ffffff;
  color: #b91c1c;
  border-color: rgba(185, 28, 28, 0.28);
}

.bluetooth-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 10rpx;
  max-height: 480rpx;
  overflow-y: auto;
}

.bluetooth-device {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.14);
}

.device-main {
  flex: 1;
  min-width: 0;
}

.device-name {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-dark);
  margin-bottom: 6rpx;
}

.device-id {
  font-size: 22rpx;
  color: var(--text-light);
  word-break: break-all;
}

.device-rssi {
  min-width: 72rpx;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: #e8f8fb;
  color: #0b6474;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.bluetooth-empty {
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-light);
  font-size: 26rpx;
  text-align: center;
}

.plan-section:nth-child(3) .plan-title,
.plan-section:nth-child(3) .plan-item {
  border-left-color: var(--accent-color);
}

.plan-section:nth-child(4) .plan-title,
.plan-section:nth-child(4) .plan-item {
  border-left-color: #5856d6;
}

.emergency-save-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.56);
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff453a, #d70015);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(255, 59, 48, 0.26);
}

.photo-entry {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 22rpx;
  background-color: var(--primary-soft);
}

.photo-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border: 2rpx solid rgba(37, 111, 123, 0.22);
  background-color: #ffffff;
}

.photo-preview image {
  width: 100%;
  height: 100%;
}

.photo-actions {
  flex: 1;
}

.photo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 22rpx;
  border: 2rpx solid #111827;
  border-radius: 18rpx;
  background: #111827;
  color: #ffffff !important;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.25);
}

.photo-tip {
  margin-top: 10rpx;
  color: var(--text-light);
  font-size: 22rpx;
  line-height: 1.4;
}

.algorithm-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(60, 60, 67, 0.12);
}

.algorithm-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34c759;
  flex-shrink: 0;
}

.algorithm-dot.loading {
  background: #ff9f0a;
  box-shadow: 0 0 0 8rpx rgba(255, 159, 10, 0.14);
}

.algorithm-text {
  flex: 1;
  min-width: 0;
  color: var(--text-dark);
  font-size: 22rpx;
  line-height: 1.4;
}

.camera-panel {
  margin-bottom: 30rpx;
  overflow: hidden;
  border: 2rpx solid var(--border-color);
  border-radius: 14rpx;
}

.camera-actions {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  background-color: #ffffff;
}

.camera-actions .btn {
  border-radius: 18rpx;
  border: 2rpx solid var(--border-color);
}

.camera-actions .btn-cancel {
  background: #f4f4f6;
  color: var(--text-dark);
}

.camera-actions .btn-confirm {
  background: #111827;
  color: #ffffff !important;
  border-color: #000000;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.30);
}
