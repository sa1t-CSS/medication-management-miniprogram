.custom-tab-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  height: 108rpx;
  display: flex;
  align-items: center;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 34rpx;
  box-shadow: 0 16rpx 44rpx rgba(60, 60, 67, 0.18);
  z-index: 999;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8e8e93;
  border: 2rpx solid transparent;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.tab-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #007aff 0%, #0051d5 100%);
  border-color: rgba(255, 255, 255, 0.56);
  box-shadow: 0 10rpx 26rpx rgba(0, 122, 255, 0.28);
}

.tab-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  background: rgba(0, 122, 255, 0.10);
  color: inherit;
}

.tab-item.active .tab-icon {
  background: rgba(255, 255, 255, 0.18);
}

.tab-text {
  line-height: 1;
  letter-spacing: 0;
}
